# SpaceTraders API Token
# Get your token from https://spacetraders.io or by registering a new agent
SPACETRADERS_TOKEN=your_token_here

# Keep container running for continuous operations
KEEP_ALIVE=false

# New agent registration (only use once)
REGISTER_NEW_AGENT=false
AGENT_CALLSIGN=YourCallsign
AGENT_FACTION=COSMIC
